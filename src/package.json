{
  "name": "myapp",
  "version": "1.0.0",
  "description": "Sample Express app for the AWS End-to-End CI/CD capstone",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "jest"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "jest": "^29.6.1",
    "jest-junit": "^16.0.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": ["<rootDir>/../tests"],
    "modulePaths": ["<rootDir>/node_modules"],
    "reporters": ["default", "jest-junit"]
  },
  "jest-junit": {
    "outputDirectory": ".",
    "outputName": "junit.xml"
  }
}
